---
export const prerender = true;
import PostLayout from "@/layouts/PostLayout.astro";
import { DEFAULT_LOCALE, getPosts, LOCALES, slugOf } from "@/lib/posts";

// Translations: /en/blog/<slug> and /ru/blog/<slug>. The Uzbek original stays at /blog/<slug>.
export async function getStaticPaths() {
  const paths = [];
  for (const lang of LOCALES.filter((locale) => locale !== DEFAULT_LOCALE)) {
    const posts = await getPosts(lang);
    paths.push(
      ...posts.map((post, i) => ({
        params: { lang, slug: slugOf(post) },
        props: { post, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null },
      })),
    );
  }
  return paths;
}

const { post, newer, older } = Astro.props;
---

<PostLayout post={post} newer={newer} older={older} />
