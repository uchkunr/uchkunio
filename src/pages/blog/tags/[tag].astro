---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PostList from "@/components/PostList.astro";
import { ArrowLeft } from "@lucide/astro";
import { getPosts } from "@/lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`Tagged ${tag}`} description={`Posts tagged "${tag}".`}>
  <Breadcrumbs items={[{ name: "Writing", href: "/blog" }, { name: tag, href: `/blog/tags/${tag}` }]} />

  <div class="mx-auto max-w-[40rem] px-6 pt-12 pb-20 sm:pt-20">
    <a href="/blog" class="quiet inline-flex items-center gap-1.5 text-sm" data-reveal style="--i: 0">
      <ArrowLeft size={14} stroke-width={1.75} aria-hidden="true" />
      Writing
    </a>

    <header class="mt-8 flex items-baseline justify-between" data-reveal style="--i: 1">
      <h1 class="text-[1.6rem] font-semibold tracking-[-0.02em]">
        <span class="text-fg-3">Tagged</span> {tag}
      </h1>
      <p class="meta">{posts.length} {posts.length === 1 ? "post" : "posts"}</p>
    </header>

    <PostList posts={posts} class="mt-6" data-reveal style="--i: 2" />
  </div>
</BaseLayout>
