---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PostList from "@/components/PostList.astro";
import Icon from "@/components/Icon.astro";
import { getPosts, groupByYear } from "@/lib/posts";

const posts = await getPosts();
const years = groupByYear(posts);
---

<BaseLayout title="Writing" description="Notes on backend engineering: Node.js, TypeScript, databases, and the systems around them.">
  <Breadcrumbs items={[{ name: "Writing", href: "/blog" }]} />

  <div class="mx-auto max-w-[40rem] px-6 pt-12 pb-20 sm:pt-20">
    <header class="flex items-baseline justify-between" data-reveal style="--i: 0">
      <h1 class="text-[1.6rem] font-semibold tracking-[-0.02em]">Writing</h1>
      <p class="meta">{posts.length} {posts.length === 1 ? "post" : "posts"}</p>
    </header>

    <label class="search mt-8" data-reveal style="--i: 1">
      <Icon name="search" size={15} />
      <input
        id="search"
        type="search"
        placeholder="Search"
        autocomplete="off"
        spellcheck="false"
        aria-label="Search posts"
      />
      <kbd class="kbd">/</kbd>
    </label>

    <div class="mt-4" data-reveal style="--i: 2">
      {
        years.map(([year, group]) => (
          <section class="pt-6" data-year>
            <h2 class="meta">{year}</h2>
            <PostList posts={group} dateStyle="day" class="mt-1" />
          </section>
        ))
      }
      <p class="py-12 text-center text-sm text-fg-3" data-empty hidden>Nothing matches.</p>
    </div>
  </div>
</BaseLayout>

<script>
  function initSearch() {
    const input = document.querySelector<HTMLInputElement>("#search");
    if (!input) return;
    const posts = [...document.querySelectorAll<HTMLElement>("[data-post]")];
    const years = [...document.querySelectorAll<HTMLElement>("[data-year]")];
    const empty = document.querySelector<HTMLElement>("[data-empty]");

    const filter = () => {
      const query = input.value.trim().toLowerCase();
      let shown = 0;
      for (const post of posts) {
        const hit = !query || (post.dataset.search ?? "").includes(query);
        post.hidden = !hit;
        if (hit) shown++;
      }
      for (const year of years) year.hidden = !year.querySelector("[data-post]:not([hidden])");
      if (empty) empty.hidden = shown > 0;
    };

    input.addEventListener("input", filter);
    const initial = new URLSearchParams(location.search).get("q");
    if (initial) {
      input.value = initial;
      filter();
    }
  }

  document.addEventListener("astro:page-load", initSearch);

  document.addEventListener("keydown", (event) => {
    const input = document.querySelector<HTMLInputElement>("#search");
    if (!input) return;
    const typing = event.target instanceof HTMLElement && event.target.matches("input, textarea, select");
    if (event.key === "/" && !typing) {
      event.preventDefault();
      input.focus();
      input.select();
    } else if (event.key === "Escape" && event.target === input) {
      input.value = "";
      input.dispatchEvent(new Event("input"));
      input.blur();
    }
  });
</script>
