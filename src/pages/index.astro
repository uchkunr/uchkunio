---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SOCIAL_LINKS, SITE } from "@/config/site";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Uchkun Rakhimov",
  alternateName: ["uchkunio", "uchkunr", "Uchkun I/O"],
  url: SITE.url,
  jobTitle: "Backend Engineer",
  description: SITE.description,
  email: "uchkunrakhimov@gmail.com",
  knowsAbout: [
    "Node.js", "TypeScript", "NestJS", "Express.js", "Fastify",
    "PostgreSQL", "MongoDB", "Redis", "GraphQL",
    "Google Cloud Platform", "AWS", "Docker", "CI/CD",
    "Distributed Systems", "API Design", "Backend Engineering",
  ],
  sameAs: SOCIAL_LINKS.map((l) => l.href).filter((h) => !h.startsWith("mailto:")),
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Uchkun I/O",
  alternateName: "uchkun.io",
  url: SITE.url,
  description: SITE.description,
  author: { "@type": "Person", name: "Uchkun Rakhimov" },
};
---

<BaseLayout>
  <Fragment slot="default">
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <section class="pt-6 pb-10 sm:pt-10 sm:pb-16 animate-fade-in">
        <div class="relative h-16 w-16 sm:h-20 sm:w-20 mb-4 sm:mb-5 rounded-full overflow-hidden ring-1 ring-foreground/10 bg-gradient-to-br from-primary/30 via-primary/10 to-muted">
          <span
            class="absolute inset-0 flex items-center justify-center text-lg sm:text-xl font-semibold text-foreground/70 select-none"
            aria-hidden="true"
          >
            UR
          </span>
          <img
            src="https://avatars.githubusercontent.com/u/105480357?v=4"
            alt={SITE.name}
            class="absolute inset-0 h-full w-full object-cover"
            onerror="this.style.display='none'"
            loading="eager"
            decoding="async"
          />
        </div>

        <h1 class="text-2xl sm:text-3xl md:text-4xl font-semibold tracking-tight mb-3 sm:mb-4">
          {SITE.name}
        </h1>

        <div class="prose prose-neutral dark:prose-invert max-w-2xl text-base sm:text-lg text-muted-foreground leading-7 sm:leading-8 space-y-4 sm:space-y-5">
          <p>
            I'm a backend engineer from Tashkent, Uzbekistan. I build scalable distributed systems, secure API architectures, and robust database models.
          </p>

          <p>
            With 4+ years of experience across <a href="https://carlink.pro" target="_blank" rel="noopener noreferrer" class="font-medium text-foreground underline decoration-foreground/30 underline-offset-4 hover:decoration-foreground transition-colors">Carlink</a>, <a href="https://startupsdna.com" target="_blank" rel="noopener noreferrer" class="font-medium text-foreground underline decoration-foreground/30 underline-offset-4 hover:decoration-foreground transition-colors">Startups DNA</a>, <a href="https://numeo.ai" target="_blank" rel="noopener noreferrer" class="font-medium text-foreground underline decoration-foreground/30 underline-offset-4 hover:decoration-foreground transition-colors">Numeo</a>, and <a href="https://etc.uz" target="_blank" rel="noopener noreferrer" class="font-medium text-foreground underline decoration-foreground/30 underline-offset-4 hover:decoration-foreground transition-colors">East Telecom</a>, I specialize in TypeScript, Node.js (NestJS, Fastify), PostgreSQL, MongoDB, and cloud infrastructure.
          </p>
        </div>



        <div class="mt-8 sm:mt-10 text-base sm:text-lg text-muted-foreground leading-7 sm:leading-8 max-w-2xl">
          <p>
            I write on <a href="/blog" class="font-medium text-foreground underline decoration-foreground/30 underline-offset-4 hover:decoration-foreground transition-colors">the blog</a>.
            Email is <a href="mailto:uchkunrakhimov@gmail.com" class="font-medium text-foreground underline decoration-foreground/30 underline-offset-4 hover:decoration-foreground transition-colors">uchkunrakhimov@gmail.com</a>.
          </p>
        </div>
      </section>
    </div>
  </Fragment>
</BaseLayout>
