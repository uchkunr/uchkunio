---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostList from "@/components/PostList.astro";
import { ArrowUpRight } from "@lucide/astro";
import { SITE, SOCIAL_LINKS } from "@/config/site";
import { getPosts } from "@/lib/posts";

const posts = (await getPosts()).slice(0, 4);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.name,
  alternateName: ["uchkunio", "uchkunr", "Uchkun I/O"],
  url: SITE.url,
  jobTitle: "Backend Engineer",
  description: SITE.description,
  email: "uchkunrakhimov@gmail.com",
  knowsAbout: [
    "Node.js", "TypeScript", "NestJS", "Express.js", "Fastify",
    "PostgreSQL", "MongoDB", "Redis", "GraphQL",
    "Google Cloud Platform", "AWS", "Docker", "CI/CD",
    "Distributed Systems", "API Design", "Backend Engineering",
  ],
  sameAs: SOCIAL_LINKS.map((l) => l.href).filter((h) => !h.startsWith("mailto:")),
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Uchkun I/O",
  alternateName: "uchkun.io",
  url: SITE.url,
  description: SITE.description,
  author: { "@type": "Person", name: SITE.name },
};
---

<BaseLayout>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

  <div class="mx-auto max-w-[40rem] px-6 pt-12 pb-20 sm:pt-20">
    <header data-reveal style="--i: 0">
      <img
        src="https://avatars.githubusercontent.com/u/105480357?v=4&s=160"
        alt=""
        width="80"
        height="80"
        class="h-20 w-20 rounded-full ring-1 ring-line"
        loading="eager"
        decoding="async"
        onerror="this.style.display='none'"
      />
      <h1 class="mt-6 text-[1.6rem] font-semibold tracking-[-0.02em]">{SITE.name}</h1>
      <p class="mt-1 text-fg-2">Backend engineer in Tashkent</p>
    </header>

    <div class="mt-8 space-y-5 text-[1.05rem] leading-[1.7] text-fg-2" data-reveal style="--i: 1">
      <p>
        I build scalable distributed systems, secure API architectures, and robust database models.
      </p>
      <p>
        4+ years across <a href="https://carlink.pro" class="link" target="_blank" rel="noopener noreferrer">Carlink</a>, <a href="https://startupsdna.com" class="link" target="_blank" rel="noopener noreferrer">Startups DNA</a>, <a href="https://numeo.ai" class="link" target="_blank" rel="noopener noreferrer">Numeo</a>, and <a href="https://etc.uz" class="link" target="_blank" rel="noopener noreferrer">East Telecom</a>. Mostly TypeScript and Node.js (NestJS, Fastify), PostgreSQL, MongoDB, and cloud infrastructure.
      </p>
    </div>

    <section class="mt-16" data-reveal style="--i: 2">
      <div class="flex items-baseline justify-between">
        <h2 class="eyebrow">Writing</h2>
        <a href="/blog" class="quiet text-sm">All posts</a>
      </div>
      <PostList posts={posts} class="mt-3" />
    </section>

    <section class="mt-14" data-reveal style="--i: 3">
      <h2 class="eyebrow">Elsewhere</h2>
      <ul class="list mt-3" data-list>
        {
          SOCIAL_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class="row"
                data-row
                target={link.href.startsWith("mailto:") ? undefined : "_blank"}
                rel={link.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
              >
                <span class="row-title">{link.label}</span>
                <span class="row-meta flex items-center gap-2 font-sans text-sm">
                  {link.handle}
                  <ArrowUpRight size={14} stroke-width={1.75} class="row-arrow" aria-hidden="true" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
