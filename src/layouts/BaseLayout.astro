---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import SEOHead from "@/components/SEOHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Analytics from "@vercel/analytics/astro";
import { Check, Copy } from "@lucide/astro";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  type?: "website" | "article";
  publishedDate?: string;
  tags?: string[];
  ogLocale?: string;
  /** og:locale of the page's other language versions. */
  ogLocaleAlternates?: string[];
  /** Other language versions of this page, emitted as hreflang links. */
  alternates?: { hreflang: string; href: string }[];
  /** BCP 47 language of the page content. The site chrome is English. */
  lang?: string;
  /** Shown in the header once the page's own heading scrolls away. */
  headerTitle?: string;
}

const { headerTitle, lang = "en", ...seo } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <SEOHead {...seo} />
    <Font cssVariable="--font-jost" preload />
    <ClientRouter />
    <script is:inline>
      // Before first paint, so the page never flashes the wrong theme.
      (function () {
        var theme =
          localStorage.getItem("theme") ||
          (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.classList.toggle("dark", theme === "dark");
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <Header title={headerTitle} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <!-- Icons for the code copy button, which the layout script builds at runtime. -->
    <template data-code-copy>
      <Copy class="copy" size={14} stroke-width={1.75} aria-hidden="true" />
      <Check class="ok" size={14} stroke-width={2} aria-hidden="true" />
    </template>
    <!-- In <body>, not <head> as Vercel's docs show: it renders a custom element,
         and the HTML parser ends <head> at the first one it meets, pushing every
         later head tag (including the stylesheet) into <body>. -->
    <Analytics />
  </body>
</html>

<script>
  // Everything interactive on the site lives here. Each page is wired up on
  // astro:page-load, and window listeners are torn down on astro:before-swap.

  const root = document.documentElement;
  const HEADER = 56;
  const reducedMotion = () => matchMedia("(prefers-reduced-motion: reduce)").matches;

  let cleanups: (() => void)[] = [];
  document.addEventListener("astro:before-swap", () => {
    cleanups.forEach((fn) => fn());
    cleanups = [];
  });

  /** Run fn on scroll, at most once per frame, and once immediately. */
  function onScroll(fn: () => void) {
    let queued = false;
    const handler = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        fn();
        queued = false;
      });
    };
    addEventListener("scroll", handler, { passive: true });
    cleanups.push(() => removeEventListener("scroll", handler));
    fn();
  }

  // ── Theme ────────────────────────────────────────────────────────────
  const systemDark = matchMedia("(prefers-color-scheme: dark)");
  const preferredTheme = () => localStorage.getItem("theme") ?? (systemDark.matches ? "dark" : "light");
  const applyTheme = (theme: string) => root.classList.toggle("dark", theme === "dark");

  // The router replaces <html> attributes with the incoming page's, which drops the class.
  document.addEventListener("astro:after-swap", () => applyTheme(preferredTheme()));
  systemDark.addEventListener("change", () => {
    if (!localStorage.getItem("theme")) applyTheme(preferredTheme());
  });

  document.addEventListener("click", (event) => {
    if (!(event.target as Element).closest("[data-theme-toggle]")) return;
    const next = root.classList.contains("dark") ? "light" : "dark";
    const commit = () => {
      applyTheme(next);
      localStorage.setItem("theme", next);
    };
    if (!document.startViewTransition || reducedMotion()) return commit();
    root.dataset.vt = "theme";
    document.startViewTransition(commit).finished.finally(() => delete root.dataset.vt);
  });

  // ── Header: border on scroll, title swap and progress on post pages ──
  function initHeader() {
    const header = document.querySelector<HTMLElement>("[data-header]");
    if (!header) return;
    const article = document.querySelector<HTMLElement>("[data-article]");
    const heading = document.querySelector<HTMLElement>("[data-article-title]");
    const progress = header.querySelector<HTMLElement>("[data-progress]");

    onScroll(() => {
      header.classList.toggle("is-scrolled", scrollY > 8);
      if (heading) header.classList.toggle("is-reading", heading.getBoundingClientRect().bottom < HEADER);
      if (article && progress) {
        const rect = article.getBoundingClientRect();
        const span = rect.height - innerHeight + HEADER;
        const value = span > 0 ? (HEADER - rect.top) / span : 1;
        progress.style.transform = `scaleX(${Math.min(Math.max(value, 0), 1)})`;
      }
    });
  }

  // ── Lists: one highlight that glides between rows ───────────────────
  function initLists() {
    document.querySelectorAll<HTMLElement>("[data-list]").forEach((list) => {
      const glide = document.createElement("span");
      glide.className = "list-glide";
      glide.setAttribute("aria-hidden", "true");
      list.prepend(glide);
      let shown = false;

      const show = (row: HTMLElement) => {
        glide.classList.toggle("is-instant", !shown);
        glide.style.transform = `translateY(${row.offsetTop}px)`;
        glide.style.height = `${row.offsetHeight}px`;
        glide.style.opacity = "1";
        shown = true;
      };
      const hide = () => {
        glide.style.opacity = "0";
        shown = false;
      };
      const rowOf = (target: EventTarget | null) => (target as Element | null)?.closest<HTMLElement>("[data-row]");

      list.addEventListener("pointerover", (e) => {
        const row = rowOf(e.target);
        if (row) show(row);
      });
      list.addEventListener("pointerleave", hide);
      list.addEventListener("focusin", (e) => {
        const row = rowOf(e.target);
        if (row) show(row);
      });
      list.addEventListener("focusout", (e) => {
        if (!list.contains(e.relatedTarget as Node | null)) hide();
      });
    });
  }

  // ── Table of contents ───────────────────────────────────────────────
  function initToc() {
    const toc = document.querySelector<HTMLElement>("[data-toc]");
    if (!toc) return;
    const links = [...toc.querySelectorAll<HTMLAnchorElement>("a[href^='#']")];
    const dashes = [...toc.querySelectorAll<HTMLElement>("[data-toc-rail] span")];
    type Target = { link: HTMLAnchorElement; dash?: HTMLElement; el: HTMLElement };
    const targets = links
      .map((link, i) => ({ link, dash: dashes[i], el: document.getElementById(decodeURIComponent(link.hash.slice(1))) }))
      .filter((t): t is Target => t.el !== null);
    if (!targets.length) return;

    // Touch screens have no hover: a tap on the rail opens the list, a tap anywhere else closes it.
    const close = (event: Event) => {
      if (!toc.contains(event.target as Node)) toc.classList.remove("is-open");
    };
    document.addEventListener("click", close);
    cleanups.push(() => document.removeEventListener("click", close));

    onScroll(() => {
      // Active = the last heading that has crossed the upper third of the viewport.
      let active = targets[0];
      for (const t of targets) {
        if (t.el.getBoundingClientRect().top > innerHeight * 0.33) break;
        active = t;
      }
      for (const t of targets) {
        t.link.classList.toggle("is-active", t === active);
        t.dash?.classList.toggle("is-active", t === active);
      }
    });
  }

  document.addEventListener("click", (event) => {
    const toc = (event.target as Element).closest("[data-toc-rail]")?.closest("[data-toc]");
    toc?.classList.toggle("is-open");
  });

  // ── Language menu: a <details>; close it on an outside click or Escape ──
  document.addEventListener("click", (event) => {
    document.querySelectorAll<HTMLDetailsElement>("[data-lang-menu][open]").forEach((menu) => {
      if (!menu.contains(event.target as Node)) menu.open = false;
    });
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    const menu = document.querySelector<HTMLDetailsElement>("[data-lang-menu][open]");
    if (!menu) return;
    menu.open = false;
    menu.querySelector("summary")?.focus();
  });

  // ── Back to top ─────────────────────────────────────────────────────
  function initToTop() {
    const button = document.querySelector<HTMLButtonElement>("[data-to-top]");
    if (!button) return;
    onScroll(() => {
      const visible = scrollY > innerHeight;
      button.classList.toggle("is-visible", visible);
      // Inert while hidden: out of the tab order and away from screen readers.
      button.inert = !visible;
    });
  }

  document.addEventListener("click", (event) => {
    if (!(event.target as Element).closest("[data-to-top]")) return;
    scrollTo({ top: 0, behavior: reducedMotion() ? "auto" : "smooth" });
    history.replaceState(null, "", location.pathname + location.search);
  });

  // ── Sprouts: click the name and twigs and leaves grow out of the letters ──
  // Every click grows a different plant around the visible title. The name is
  // still a link home: the plant grows there once the page has arrived.
  const SVG = "http://www.w3.org/2000/svg";

  /** The box of the text itself, not of its element (which a grid or flex can stretch). */
  function textRect(el: HTMLElement): DOMRect {
    const range = document.createRange();
    range.selectNodeContents(el);
    const text = range.getBoundingClientRect();
    const box = el.getBoundingClientRect();
    // Clamp to the element: an ellipsised title's text runs past its visible edge.
    const left = Math.max(text.left, box.left);
    const right = Math.min(text.right, box.right);
    return new DOMRect(left, text.top, Math.max(0, right - left), text.height);
  }

  function growTree(from: HTMLElement) {
    const rect = textRect(from);
    const layer = document.createElementNS(SVG, "svg");
    layer.setAttribute("class", "tree");
    layer.setAttribute("aria-hidden", "true");

    const rand = (a: number, b: number) => a + Math.random() * (b - a);
    const pick = <T,>(xs: T[]) => xs[Math.floor(Math.random() * xs.length)];
    const STEM = 300; // ms to draw one stem
    // Every click grows a different plant: its own spacing, reach and leaf size.
    const spacing = rand(9, 13);
    const reach = rand(0.85, 1.15);
    const leafScale = rand(0.9, 1.15);
    let last = 0;

    const el = (name: string, attrs: Record<string, string | number>) => {
      const node = document.createElementNS(SVG, name);
      for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v));
      return node;
    };
    // Something that appears at a point: scales up from there with a soft overshoot.
    const appear = (node: SVGElement, x: number, y: number, at: number, opacity: number, twist = 0) => {
      node.setAttribute("opacity", "0");
      node.style.transformOrigin = `${x}px ${y}px`;
      node.animate(
        [
          { opacity: 0, transform: `scale(0.2) rotate(${twist}deg)` },
          { opacity, transform: "scale(1) rotate(0deg)" },
        ],
        { duration: 420, delay: at, easing: "cubic-bezier(0.34, 1.3, 0.64, 1)", fill: "forwards" },
      );
      last = Math.max(last, at + 420);
    };

    // A leaflet: a teardrop pointing along `angle`, a faint vein down the middle.
    function leaf(g: SVGGElement, x: number, y: number, angle: number, size: number, at: number) {
      size *= leafScale;
      const tx = x + Math.cos(angle) * size;
      const ty = y + Math.sin(angle) * size;
      const nx = Math.cos(angle + Math.PI / 2) * size * 0.34;
      const ny = Math.sin(angle + Math.PI / 2) * size * 0.34;
      const m1 = 0.38, m2 = 0.5;
      const node = el("g", { "data-leaf": "" }) as SVGGElement;
      node.append(
        el("path", { d: `M${x} ${y}Q${x + (tx - x) * m1 + nx} ${y + (ty - y) * m1 + ny} ${tx} ${ty}Q${x + (tx - x) * m2 - nx} ${y + (ty - y) * m2 - ny} ${x} ${y}Z`, fill: "currentColor" }),
        el("path", { d: `M${x} ${y}L${x + (tx - x) * 0.7} ${y + (ty - y) * 0.7}`, stroke: "var(--bg)", "stroke-width": 0.5, opacity: 0.6 }),
      );
      g.append(node);
      appear(node, x, y, at, rand(0.78, 0.95), rand(-20, 20));
    }

    // A twig: a bowed line drawn on from its base. Returns the path for leaf placement.
    function twig(g: SVGGElement, x: number, y: number, angle: number, length: number, width: number, at: number) {
      const bow = rand(-0.2, 0.2) * length;
      const x2 = x + Math.cos(angle) * length;
      const y2 = y + Math.sin(angle) * length;
      const cx = (x + x2) / 2 + Math.cos(angle + Math.PI / 2) * bow;
      const cy = (y + y2) / 2 + Math.sin(angle + Math.PI / 2) * bow;
      const path = el("path", { d: `M${x} ${y}Q${cx} ${cy} ${x2} ${y2}`, fill: "none", stroke: "currentColor", "stroke-width": width, "stroke-linecap": "round", opacity: 0.85, "data-stem": "" }) as SVGPathElement;
      g.append(path);
      const total = path.getTotalLength();
      path.style.strokeDasharray = `${total}`;
      path.style.strokeDashoffset = `${total}`;
      path.animate([{ strokeDashoffset: total }, { strokeDashoffset: 0 }], { duration: STEM, delay: at, easing: "ease-out", fill: "forwards" });
      return { path, total, x2, y2 };
    }

    // A branch: a main twig that forks once or twice, leaves in pairs along it and
    // one at every tip, all pointing forward the way leaves grow. Each branch is a
    // group rooted at its base so it can sway.
    const sprouts: SVGGElement[] = [];
    function sprout(x: number, y: number, angle: number, length: number, at: number) {
      const g = el("g", {}) as SVGGElement;
      g.style.transformOrigin = `${x}px ${y}px`;
      layer.append(g);
      sprouts.push(g);

      const main = twig(g, x, y, angle, length, 1.1, at);
      const forks = length > 12 ? 2 : 1;
      const forkSide = Math.random() < 0.5 ? 1 : -1;
      for (let i = 0; i < forks; i++) {
        const t = forks === 1 ? rand(0.45, 0.6) : 0.38 + i * 0.3;
        const p = main.path.getPointAtLength(main.total * t);
        const side = i === 0 ? forkSide : -forkSide;
        const sub = twig(g, p.x, p.y, angle + side * rand(0.55, 0.85), length * rand(0.45, 0.62), 0.8, at + STEM * t);
        // A leaf at the fork's tip, and one on its outer side half-way.
        const subAngle = Math.atan2(sub.y2 - p.y, sub.x2 - p.x);
        leaf(g, sub.x2, sub.y2, subAngle + rand(-0.2, 0.2), rand(4.5, 6), at + STEM * (t + 1));
        const q = sub.path.getPointAtLength(sub.total * 0.5);
        leaf(g, q.x, q.y, subAngle + side * rand(0.7, 0.95), rand(3.8, 5), at + STEM * (t + 0.5));
      }
      // Leaves in a pair low on the main twig, and one at its tip.
      const p = main.path.getPointAtLength(main.total * 0.25);
      leaf(g, p.x, p.y, angle - rand(0.75, 0.95), rand(3.6, 4.6), at + STEM * 0.25);
      leaf(g, p.x, p.y, angle + rand(0.75, 0.95), rand(3.6, 4.6), at + STEM * 0.25 + 40);
      leaf(g, main.x2, main.y2, angle + rand(-0.2, 0.2), rand(5, 6.5), at + STEM);
    }

    // Sprouts ring the text: along the top and bottom, leaning outward from the
    // middle, and one or two from each end. The ones above stay inside the viewport.
    const count = Math.min(26, Math.max(6, Math.round(rect.width / spacing)));
    for (let i = 0; i < count; i++) {
      const t = (i + 0.5) / count;
      const x = rect.left + rect.width * t + rand(-2, 2);
      const up = i % 2 === 0;
      // Root them in the letters themselves (near the cap line and the baseline), not the line box.
      const y = up ? rect.top + rect.height * 0.32 : rect.bottom - rect.height * 0.22;
      const lean = (t - 0.5) * 1.1 + rand(-0.2, 0.2);
      const angle = up ? -Math.PI / 2 + lean : Math.PI / 2 + lean;
      let length = rand(9, 16) * reach;
      if (up) length = Math.min(length, Math.max(7, y - 5));
      sprout(x, y, angle, length, i * 55 + rand(0, 60));
    }
    for (const side of [-1, 1]) {
      const x = side < 0 ? rect.left + 1 : rect.right - 1;
      const ends = pick([1, 2, 2]);
      for (let i = 0; i < ends; i++) {
        const y = rect.top + rect.height * ((i + 0.5) / ends);
        const angle = (side < 0 ? Math.PI : 0) + (ends === 1 ? 0 : (i === 0 ? -0.35 : 0.35)) + rand(-0.15, 0.15);
        sprout(x, y, angle, rand(9, 14) * reach, rand(150, 500));
      }
    }
    document.body.append(layer);

    // Once grown, the faintest breeze: each sprout sways from its base at its own pace.
    sprouts.forEach((g) => {
      const amp = rand(0.8, 1.6);
      g.animate([{ transform: `rotate(${-amp}deg)` }, { transform: `rotate(${amp}deg)` }], {
        duration: rand(2000, 3200),
        delay: rand(0, 800),
        direction: "alternate",
        iterations: Infinity,
        easing: "ease-in-out",
      });
    });

    // Hold the finished sprouts for a while, then let them go on their own.
    setTimeout(() => {
      if (!layer.classList.contains("is-fading")) clearTree(layer);
    }, last + 2600);
  }

  function clearTree(layer: SVGSVGElement) {
    layer.classList.add("is-fading");
    const rand = (a: number, b: number) => a + Math.random() * (b - a);
    // The leaves let go and drift down, turning as they fall; the stems fade behind them.
    layer.querySelectorAll<SVGGElement>("[data-leaf]").forEach((leaf) => {
      leaf.animate(
        [
          { transform: "translate(0px, 0px) rotate(0deg)", opacity: 0.85 },
          { transform: `translate(${rand(-6, 6)}px, ${rand(10, 18)}px) rotate(${rand(-40, 40)}deg)`, opacity: 0 },
        ],
        { duration: rand(900, 1300), delay: rand(0, 400), easing: "cubic-bezier(0.4, 0, 0.8, 1)", fill: "forwards", composite: "add" },
      );
    });
    layer.querySelectorAll<SVGPathElement>("[data-stem]").forEach((part) => {
      part.animate([{ opacity: 0.85 }, { opacity: 0 }], { duration: 700, delay: 300, easing: "ease-out", fill: "forwards" });
    });
    setTimeout(() => layer.remove(), 1800);
  }

  /** Lets any standing plant go and grows a fresh one from `from`. */
  function replant(from: HTMLElement) {
    document.querySelectorAll<SVGSVGElement>(".tree:not(.is-fading)").forEach(clearTree);
    growTree(from);
  }

  const SPROUT_ON_ARRIVAL = "sprout";
  document.addEventListener("click", (event) => {
    const title = (event.target as Element).closest<HTMLElement>("[data-tree]");
    if (!title || reducedMotion()) return;
    const link = (event.target as Element).closest("a");
    if (link) {
      // The name goes home as a link should; the plant grows there on arrival.
      // On the home page itself there is nowhere to go, so it grows right away.
      if (location.pathname === "/") {
        event.preventDefault();
        replant(link);
      } else {
        sessionStorage.setItem(SPROUT_ON_ARRIVAL, "1");
      }
      return;
    }
    const post = title.querySelector<HTMLElement>(".header-post");
    if (post) replant(post);
  }, true); // capture: before the router's own click listener, which honours preventDefault
  document.addEventListener("astro:page-load", () => {
    if (!sessionStorage.getItem(SPROUT_ON_ARRIVAL)) return;
    sessionStorage.removeItem(SPROUT_ON_ARRIVAL);
    const name = document.querySelector<HTMLElement>(".header-name");
    if (name && !reducedMotion()) setTimeout(() => replant(name), 250);
  });
  document.addEventListener("astro:before-swap", () => document.querySelector(".tree")?.remove());

  document.addEventListener("click", (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>("[data-toc] a[href^='#']");
    if (!link) return;
    const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
    if (!target) return;
    event.preventDefault();
    target.scrollIntoView({ behavior: reducedMotion() ? "auto" : "smooth" });
    history.replaceState(null, "", link.hash);
    link.closest("[data-toc]")?.classList.remove("is-open");
  });

  // ── Code blocks and tables ──────────────────────────────────────────
  // Copy and check icons, rendered once by the layout as Lucide SVGs.
  const COPY_ICONS = document.querySelector<HTMLTemplateElement>("[data-code-copy]")?.innerHTML ?? "";

  function initProse() {
    document.querySelectorAll<HTMLPreElement>(".prose pre.astro-code").forEach((pre) => {
      if (pre.parentElement?.classList.contains("code")) return;
      const lang = pre.dataset.language === "plaintext" ? "text" : (pre.dataset.language ?? "");
      const figure = document.createElement("figure");
      figure.className = "code";
      figure.innerHTML = `<div class="code-bar"><span>${lang}</span><button type="button" class="code-copy" data-copy aria-label="Copy code">${COPY_ICONS}</button></div>`;
      pre.replaceWith(figure);
      figure.append(pre);
    });
    document.querySelectorAll<HTMLTableElement>(".prose table").forEach((table) => {
      if (table.parentElement?.classList.contains("table-wrap")) return;
      const wrap = document.createElement("div");
      wrap.className = "table-wrap";
      table.replaceWith(wrap);
      wrap.append(table);
    });
    // Demo videos autoplay like GIFs; with reduced motion they wait for the reader instead.
    if (reducedMotion()) {
      document.querySelectorAll<HTMLVideoElement>(".prose video[autoplay]").forEach((video) => {
        video.autoplay = false;
        video.pause();
        video.controls = true;
      });
    }
  }

  document.addEventListener("click", async (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>("[data-copy]");
    const code = button?.closest(".code")?.querySelector("pre");
    if (!button || !code) return;
    try {
      await navigator.clipboard.writeText(code.innerText);
    } catch {
      return; // Clipboard refused (insecure context or no focus). Nothing to confirm.
    }
    button.classList.add("is-copied");
    setTimeout(() => button.classList.remove("is-copied"), 1600);
  });

  document.addEventListener("astro:page-load", () => {
    initHeader();
    initLists();
    initToc();
    initToTop();
    initProse();
  });
</script>
