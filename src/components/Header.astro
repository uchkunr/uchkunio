---
interface Props {
  /** Replaces the site name once the page's own heading scrolls out of view. */
  title?: string;
}

const { title } = Astro.props;
const onWriting = Astro.url.pathname.startsWith("/blog");
---

<header class="header" data-header>
  <div class="mx-auto flex h-14 max-w-[40rem] items-center justify-between gap-6 px-6">
    <div class="header-title">
      <a href="/" class="header-name text-[0.95rem] font-medium tracking-[-0.01em]">Uchkun Rakhimov</a>
      {title && <span class="header-post" aria-hidden="true">{title}</span>}
    </div>

    <nav class="flex items-center gap-1" aria-label="Primary">
      <a href="/blog" class="nav-link" aria-current={onWriting ? "page" : undefined}>Writing</a>
      <button type="button" class="theme" data-theme-toggle aria-label="Toggle dark mode">
        <svg class="sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path>
        </svg>
        <svg class="moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"></path>
        </svg>
      </button>
    </nav>
  </div>
  {title && <span class="header-progress" data-progress aria-hidden="true"></span>}
</header>
