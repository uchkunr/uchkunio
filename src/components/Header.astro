---
import { Moon, Sun } from "@lucide/astro";
import Logo from "@/assets/logo.svg";

interface Props {
  /** Replaces the site name once the page's own heading scrolls out of view. */
  title?: string;
}

const { title } = Astro.props;
const onWriting = Astro.url.pathname.startsWith("/blog");
---

<header class="header" data-header>
  <div class="mx-auto flex h-14 max-w-[40rem] items-center justify-between gap-6 px-6">
    <div class="header-title">
      <span class="header-name inline-flex items-center gap-1.5 text-[0.95rem] font-medium tracking-[-0.01em]">
        <button type="button" class="header-logo-btn" data-moths aria-label="Release the moths">
          <Logo class="header-logo" aria-hidden="true" />
        </button>
        <a href="/">Uchkun Rakhimov</a>
      </span>
      {title && <span class="header-post" aria-hidden="true">{title}</span>}
    </div>

    <nav class="flex items-center gap-1" aria-label="Primary">
      <a href="/blog" class="nav-link" aria-current={onWriting ? "page" : undefined}>Writing</a>
      <button type="button" class="theme" data-theme-toggle aria-label="Toggle dark mode">
        <Sun class="sun" size={20} stroke-width={1.75} aria-hidden="true" />
        <Moon class="moon" size={20} stroke-width={1.75} aria-hidden="true" />
      </button>
    </nav>
  </div>
  {title && <span class="header-progress" data-progress aria-hidden="true"></span>}
</header>
